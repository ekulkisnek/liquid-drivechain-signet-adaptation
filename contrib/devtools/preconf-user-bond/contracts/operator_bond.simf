// Separate PRECONFER collateral, one protected outpoint/session. Not insurance.
// Two incompatible promises by the preconfer alone suffice to penalize it.
// The user's signature is still required by the principal's own spending rules.
type Promise = (u256, Signature);
type Evidence = (Promise, Promise);

fn not(bit: bool) -> bool {
    <u1>::into(jet::complement_1(<bool>::into(bit)))
}

fn absent(value: Option<u256>) {
    match value { Some(_: u256) => panic!(), None => (), }
}

fn receipt_hash(spend_txid: u256) -> u256 {
    let (bond_txid, bond_vout): Outpoint = jet::current_prev_outpoint();
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, param::DOMAIN);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, param::GENESIS);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, bond_txid);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, bond_vout);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, jet::current_script_hash());
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, param::PROTECTED_TXID);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, param::PROTECTED_VOUT);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_8(ctx, param::EPOCH);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, param::ACTIVE_UNTIL);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, param::REFUND_HEIGHT);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, spend_txid);
    jet::sha_256_ctx_8_finalize(ctx)
}

fn verify_promise(promise: Promise) {
    let (spend_txid, sig): Promise = promise;
    jet::bip_0340_verify((param::PRECONFER, receipt_hash(spend_txid)), sig);
}

fn penalty(evidence: Evidence) {
    let (first, second): Evidence = evidence;
    let (first_txid, _): Promise = first;
    let (second_txid, _): Promise = second;
    assert!(not(jet::eq_256(first_txid, second_txid)));
    verify_promise(first);
    verify_promise(second);
    assert!(jet::eq_32(jet::num_outputs(), 1));
    assert!(unwrap(jet::output_is_fee(0)));
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::output_amount(0));
    assert!(jet::eq_256(unwrap_right::<(u1, u256)>(asset), param::FEE_ASSET));
    assert!(jet::eq_64(unwrap_right::<(u1, u256)>(amount), param::COLLATERAL));
}

fn main() {
    assert!(jet::eq_256(jet::genesis_block_hash(), param::GENESIS));
    assert!(jet::eq_32(jet::num_inputs(), 1));
    assert!(jet::eq_32(jet::current_index(), 0));
    let (bond_txid, bond_vout): Outpoint = jet::current_prev_outpoint();
    let same_txid: bool = jet::eq_256(bond_txid, param::PROTECTED_TXID);
    let same_vout: bool = jet::eq_32(bond_vout, param::PROTECTED_VOUT);
    assert!(not(<u1>::into(jet::and_1(<bool>::into(same_txid), <bool>::into(same_vout)))));
    absent(jet::current_pegin());
    absent(jet::current_new_issuance_contract());
    absent(jet::current_reissuance_entropy());
    assert!(jet::lt_32(0, param::ACTIVE_UNTIL));
    assert!(jet::lt_32(param::ACTIVE_UNTIL, param::REFUND_HEIGHT));
    assert!(jet::lt_32(param::REFUND_HEIGHT, 500000000));
    assert!(jet::lt_64(0, param::COLLATERAL));
    let (asset, amount): (Asset1, Amount1) = jet::current_amount();
    assert!(jet::eq_256(unwrap_right::<(u1, u256)>(asset), param::FEE_ASSET));
    assert!(jet::eq_64(unwrap_right::<(u1, u256)>(amount), param::COLLATERAL));
    match witness::ACTION {
        Left(evidence: Evidence) => penalty(evidence),
        Right(sig: Signature) => {
            jet::check_lock_height(param::REFUND_HEIGHT);
            jet::bip_0340_verify((param::PRECONFER, jet::sig_all_hash()), sig);
        },
    }
}
