-- Portable project template copied by reproduce.sh into its fresh workspace.
-- Install this compiler on PATH; no machine-specific compiler path is needed.
packages: ./catalogue-upstream
with-compiler: ghc-9.6.7
optimization: 2
jobs: 2
tests: False
benchmarks: False
write-ghc-environment-files: never
constraints: split == 0.2.5,
             prettyprinter == 1.7.2
